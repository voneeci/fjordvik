{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "bar_total_by_site",
  "position": {
    "x": 800,
    "y": 200,
    "z": 500,
    "height": 236,
    "width": 460,
    "tabOrder": 500
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_site"
                    }
                  },
                  "Property": "site_name"
                }
              },
              "queryRef": "dim_site.site_name",
              "nativeQueryRef": "site_name",
              "displayName": "Site",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Emissions (tCO2e)"
                }
              },
              "queryRef": "_Measures.Total Emissions (tCO2e)",
              "nativeQueryRef": "Total Emissions (tCO2e)"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Total Emissions (tCO2e)"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1F6FA8'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1000D"
                }
              }
            },
            "labelPrecision": {
              "expr": {
                "Literal": {
                  "Value": "0L"
                }
              }
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "maxMarginFactor": {
              "expr": {
                "Literal": {
                  "Value": "45L"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Emissions by site, with use of the products made (tCO2e)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
