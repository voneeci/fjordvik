{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "bar_by_source",
  "position": {
    "x": 20,
    "y": 104,
    "z": 300,
    "height": 580,
    "width": 420,
    "tabOrder": 300
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_source"
                    }
                  },
                  "Property": "source_name"
                }
              },
              "queryRef": "dim_source.source_name",
              "nativeQueryRef": "source_name",
              "displayName": "Source",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Emissions (tCO2e)"
                }
              },
              "queryRef": "_Measures.Total Emissions (tCO2e)",
              "nativeQueryRef": "Total Emissions (tCO2e)"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Total Emissions (tCO2e)"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1F6FA8'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1000D"
                }
              }
            },
            "labelPrecision": {
              "expr": {
                "Literal": {
                  "Value": "1L"
                }
              }
            }
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "maxMarginFactor": {
              "expr": {
                "Literal": {
                  "Value": "45L"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Emissions by source (tCO2e)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
