                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Fjordvik Manufacturing Oy makes electric pumps and pump systems for water utilities, industry and buildings: process pumps in Tampere, water and wastewater pumps in Gothenburg, pump packages and controls in Tallinn, with warehouses in Oulu and Tartu and a head office in Helsinki.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each month the sites report the energy, fuel, refrigerant, flights and waste they used; purchasing, logistics and energy contracts add the value chain. This report turns them into greenhouse gas emissions, January 2023 to December 2025.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tartu Warehouse opened in July 2024, and Tampere Plant installed rooftop solar panels the same month.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
