    "tabOrder": 600
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read the figures",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Scope 1: direct emissions from fuel burned on site and refrigerant leaks. Scope 2: electricity and heat bought, using each country's average factor (location-based). Scope 3: business flights and waste to landfill.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "tCO2e is tonnes of carbon dioxide equivalent: activity amount times emission factor, divided by 1,000.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Intensity divides emissions by average full-time equivalent employees (FTE) or by revenue in millions of euros, so a growing business can see whether it is getting cleaner as well as bigger.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Like-for-like change compares only site-months reported in both years, so a new site does not inflate growth. The What changed page shows both views.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Most pages have Year or Country slicers at the top right: pick a value to filter that page.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
