annotation PBI_QueryOrder = ["DataFolder","dim_date","dim_site","dim_source","fact_emissions","fact_site_metrics","dim_scope3_category","dim_contract","fact_scope2_market","fact_energy_upstream","dim_supplier","fact_purchases","fact_freight"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table dim_date
ref table dim_site
ref table dim_source
ref table fact_emissions
ref table fact_site_metrics
ref table dim_scope3_category
ref table dim_contract
ref table fact_scope2_market
