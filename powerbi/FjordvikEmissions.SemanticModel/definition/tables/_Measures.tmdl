	/// Card context for Net Sales (EUR) against Fjordvik's budget (fact_budget): the plan and the variance on it. Text, for the line under the card.
	measure 'Net Sales Budget Context' =
			VAR Now = [Net Sales (EUR)]
			VAR Plan = [Budget Net Sales (EUR)]
			RETURN
				IF ( ISBLANK ( Plan ), "No budget", "Budget: " & FORMAT ( DIVIDE ( Plan, 1000000 ), "#,0.0" ) & "M" & ", " & FORMAT ( DIVIDE ( Now - Plan, Plan ), "+0.0%;-0.0%;0.0%" ) )
		displayFolder: Text
		lineageTag: 7cd62489-3cd6-4c81-a0eb-7d11cdce7289

	/// Card context for Margin (EUR) against Fjordvik's budget (fact_budget): the plan and the variance on it. Text, for the line under the card.
	measure 'Margin Budget Context' =
			VAR Now = [Margin (EUR)]
			VAR Plan = [Budget Margin (EUR)]
			RETURN
				IF ( ISBLANK ( Plan ), "No budget", "Budget: " & FORMAT ( DIVIDE ( Plan, 1000000 ), "#,0.0" ) & "M" & ", " & FORMAT ( DIVIDE ( Now - Plan, Plan ), "+0.0%;-0.0%;0.0%" ) )
		displayFolder: Text
		lineageTag: cf50802a-0133-46d9-a659-d88afff69653

	/// Card context for Margin (%) against Fjordvik's budget (fact_budget): the plan and the variance on it. Text, for the line under the card.
	measure 'Margin Percent Budget Context' =
			VAR Now = [Margin (%)]
			VAR Plan = DIVIDE ( [Budget Margin (EUR)], [Budget Net Sales (EUR)] )
			RETURN
				IF ( ISBLANK ( Plan ), "No budget", "Budget: " & FORMAT ( Plan, "0.0%" ) & ", " & SUBSTITUTE ( FORMAT ( Now - Plan, "+0.0%;-0.0%;0.0%" ), "%", " pts" ) )
		displayFolder: Text
		lineageTag: 2678374b-8064-4369-971a-f04626acb216

