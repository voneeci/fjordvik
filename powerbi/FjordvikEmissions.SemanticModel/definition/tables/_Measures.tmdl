/// Home table for every measure. Holds no data; its one column is hidden.
table _Measures
	lineageTag: fab0b0d6-ec8d-4b05-93d5-cdc75cc9aa13

	/// Tonnes of CO2 equivalent, location-based: scope 1, scope 2 location-based and the scope 3 categories held (1; 3 parts a and c; 4; 5 landfill only; 6 flights only; 9; 11 outside Rest of world), from the stored tco2e columns of the five emission tables. Market-based scope 2 is a separate measure and is never added in.
	measure 'Total Emissions (tCO2e)' = SUM ( fact_emissions[tco2e] ) + SUM ( fact_energy_upstream[tco2e] ) + SUM ( fact_purchases[tco2e] ) + SUM ( fact_freight[tco2e] ) + SUM ( fact_use_phase[tco2e] )
		formatString: #,0.0
		displayFolder: Emissions
		lineageTag: e64cec5c-9db7-4ede-8586-6a5be079c405

	/// Scope 1. Direct emissions: fuels burned on site and refrigerant leaks. KEEPFILTERS means a slicer on another scope gives blank, not this scope's total.
	measure 'Scope 1 Emissions (tCO2e)' = CALCULATE ( [Total Emissions (tCO2e)], KEEPFILTERS ( dim_source[scope] = 1 ) )
		formatString: #,0.0
		displayFolder: Emissions
		lineageTag: 8a4116c5-5b0f-4dd4-92bc-bf1cfd594c89

	/// Scope 2, location-based: purchased electricity and heat at each country's grid or network average factor. KEEPFILTERS means a slicer on another scope gives blank, not this scope's total.
	measure 'Scope 2 Emissions (tCO2e)' = CALCULATE ( [Total Emissions (tCO2e)], KEEPFILTERS ( dim_source[scope] = 2 ) )
		formatString: #,0.0
		displayFolder: Emissions
		lineageTag: 1c8d9247-e126-4faa-9351-f5858f4ed090

	/// Scope 3: the categories held (purchased goods and services, upstream fuels and transmission losses, freight, waste to landfill, business flights, use of sold products). KEEPFILTERS means a slicer on another scope gives blank, not this scope's total.
	measure 'Scope 3 Emissions (tCO2e)' = CALCULATE ( [Total Emissions (tCO2e)], KEEPFILTERS ( dim_source[scope] = 3 ) )
		formatString: #,0.0
		displayFolder: Emissions
		lineageTag: 91c60ff8-91c2-4174-a0ae-8dff3f7f9e63

	/// Revenue in euros. A flow: it adds up over months.
	measure 'Revenue (EUR)' = SUM ( fact_site_metrics[revenue_eur] )
		formatString: #,0
		displayFolder: Intensity
		lineageTag: 29fb3324-d3d9-4c2a-bf98-d6becbc4013d

	/// Full-time equivalent employees. A level, not a flow: summed across sites within each month, then averaged over the months.
	measure 'Average FTE' = AVERAGEX ( VALUES ( dim_date[date_key] ), CALCULATE ( SUM ( fact_site_metrics[fte] ) ) )
		formatString: #,0.0
		displayFolder: Intensity
		lineageTag: 69007e37-33a5-4d21-88af-25f6f86d6931

	/// Total emissions divided by average FTE for the selected period.
	measure 'Emissions per FTE (tCO2e)' = DIVIDE ( [Total Emissions (tCO2e)], [Average FTE] )
		formatString: #,0.00
		displayFolder: Intensity
		lineageTag: 834b2853-9b42-456c-a463-c73a228a5fb9

	/// Total emissions per million euros of revenue (1,000,000 converts euros to millions). Blank where there is no revenue, such as the head office.
	measure 'Emissions per Million EUR (tCO2e)' = DIVIDE ( [Total Emissions (tCO2e)], DIVIDE ( [Revenue (EUR)], 1000000 ) )
		formatString: #,0.0
		displayFolder: Intensity
		lineageTag: e3d5bdda-0f53-4faa-a270-02b6f219cbd9

	/// Emissions for the same months one year earlier. dim_date has one row per month, so it can't be marked as a date table and SAMEPERIODLASTYEAR doesn't apply; this shifts each month key back a year instead (20250301 to 20240301).
	measure 'Emissions Prior Year (tCO2e)' =
			VAR PriorKeys =
				SELECTCOLUMNS ( VALUES ( dim_date[date_key] ), "date_key", dim_date[date_key] - 10000 )
			RETURN
				CALCULATE ( [Total Emissions (tCO2e)], REMOVEFILTERS ( dim_date ), TREATAS ( PriorKeys, dim_date[date_key] ) )
		formatString: #,0.0
		displayFolder: Time comparison
		lineageTag: f78dccf5-9e9f-42eb-9501-c36ba12d785c

	/// Like-for-like change against the same months a year earlier: only site-months with emissions in both years count, so a site that opened partway through (Tartu, July 2024) or months with no prior year (2023) don't inflate the change. Shown as a percentage; blank when nothing is comparable.
	measure 'Emissions Change vs Prior Year (%)' =
			VAR Comparable =
				FILTER (
					CROSSJOIN ( VALUES ( dim_site[site_id] ), VALUES ( dim_date[date_key] ) ),
					NOT ISBLANK ( CALCULATE ( [Total Emissions (tCO2e)] ) )
						&& NOT ISBLANK ( CALCULATE ( [Emissions Prior Year (tCO2e)] ) )
				)
			VAR CurrentYear = SUMX ( Comparable, CALCULATE ( [Total Emissions (tCO2e)] ) )
			VAR PriorYear = SUMX ( Comparable, CALCULATE ( [Emissions Prior Year (tCO2e)] ) )
			RETURN
				DIVIDE ( CurrentYear - PriorYear, PriorYear )
		formatString: 0.0%
		displayFolder: Time comparison
		lineageTag: 0d7e4e56-0804-407e-804d-412c0704ec00

	/// Emissions worked out again row by row in all five emission tables: activity times factor, divided by 1,000 to turn kilograms into tonnes.
	measure 'Recalculated Emissions (tCO2e)' = SUMX ( fact_emissions, fact_emissions[activity_amount] * fact_emissions[emission_factor] / 1000 ) + SUMX ( fact_energy_upstream, fact_energy_upstream[activity_amount] * fact_energy_upstream[emission_factor] / 1000 ) + SUMX ( fact_purchases, fact_purchases[activity_amount] * fact_purchases[emission_factor] / 1000 ) + SUMX ( fact_freight, fact_freight[activity_amount] * fact_freight[emission_factor] / 1000 ) + SUMX ( fact_use_phase, fact_use_phase[activity_amount] * fact_use_phase[emission_factor] / 1000 )
		formatString: #,0.0
		displayFolder: Data quality
		lineageTag: 3bfe465a-607d-4148-b2e7-642163a23ccc

	/// Stored minus recalculated emissions, rounded to 0.001 t (1 kg): the stored values carry 6 decimals, so adding thousands of them leaves a few grams of rounding. Anything that survives the rounding means a row's tco2e doesn't match its activity and factor.
	measure 'Reconciliation Difference (tCO2e)' = ROUND ( [Total Emissions (tCO2e)] - [Recalculated Emissions (tCO2e)], 3 )
		formatString: #,0.000
		displayFolder: Data quality
		lineageTag: df2622dd-4b32-4b09-85a9-0008ca90bc88

	/// Number of emission rows in the current filter.
	measure 'Emission Rows' = COUNTROWS ( fact_emissions )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 000f0620-4c9f-4548-a651-1ee35e52911e

	/// Number of sites with at least one emission row in the current filter.
	measure 'Sites Reporting' = DISTINCTCOUNT ( fact_emissions[site_id] )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 01975484-20ec-4e96-bcd0-90723b71461d

	/// Natural gas, purchased electricity and district heating, the three sources reported in kWh, added together.
	measure 'Energy Used (kWh)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( fact_emissions[unit] = "kWh" ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: f996e88e-97b8-44fe-9422-d57df63cc237

	/// Natural gas burned on site (source S01). KEEPFILTERS means a filter on another source gives blank.
	measure 'Natural Gas Used (kWh)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( dim_source[source_id] = "S01" ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 79c59fa9-a266-4512-affd-c2a4fc4e11ae

	/// Electricity bought from the grid (source S05). Tampere's rooftop solar from July 2024 shows as lower purchases. KEEPFILTERS means a filter on another source gives blank.
	measure 'Electricity Purchased (kWh)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( dim_source[source_id] = "S05" ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 12ad1e2e-69e6-4c1c-9626-fff49db8ffdb

	/// Heat bought from a district heating network (source S06). KEEPFILTERS means a filter on another source gives blank.
	measure 'District Heating Purchased (kWh)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( dim_source[source_id] = "S06" ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 8317565c-d27d-41ca-9c22-8f2a99906750

	/// Diesel and liquefied petroleum gas (sources S02 and S03), both reported in litres, added together.
	measure 'Vehicle Fuel Used (litres)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( fact_emissions[unit] = "litre" ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 020c4361-40d7-4ac6-9c84-7c6e5bb50183

	/// Refrigerant lost from cooling equipment (source S04). KEEPFILTERS means a filter on another source gives blank.
	measure 'Refrigerant Leakage (kg)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( dim_source[source_id] = "S04" ) )
		formatString: #,0.0
		displayFolder: Activity
		lineageTag: c8ac9655-f80a-44f1-9d10-a89029f3c238

	/// Distance flown on business, in passenger-kilometres (source S07). KEEPFILTERS means a filter on another source gives blank.
	measure 'Business Flights (passenger-km)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( dim_source[source_id] = "S07" ) )
		formatString: #,0
		displayFolder: Activity
		lineageTag: 3fbf2df9-515f-4b2b-8e88-39c7aaa12d27

	/// Waste sent to landfill (source S08). KEEPFILTERS means a filter on another source gives blank.
	measure 'Waste to Landfill (tonnes)' = CALCULATE ( SUM ( fact_emissions[activity_amount] ), KEEPFILTERS ( dim_source[source_id] = "S08" ) )
		formatString: #,0.0
		displayFolder: Activity
		lineageTag: f0bf6c3c-9cdb-40c0-ad00-fc1d5d25cb6b

	/// Plain change against the same months a year earlier, counting every site, so a new site's whole first year counts as an increase (Tartu, July 2024). Only months whose prior year is in the data count, so 2023 is blank. Sums across sites to the company change; set it beside the like-for-like Emissions Change vs Prior Year (%).
	measure 'Emissions Change Including New Sites (tCO2e)' =
			VAR AllKeys = ALL ( dim_date[date_key] )
			VAR Months =
				FILTER ( VALUES ( dim_date[date_key] ), ( dim_date[date_key] - 10000 ) IN AllKeys )
			RETURN
				IF (
					NOT ISEMPTY ( Months ),
					SUMX ( Months, CALCULATE ( [Total Emissions (tCO2e)] ) - CALCULATE ( [Emissions Prior Year (tCO2e)] ) )
				)
		formatString: #,0.0
		displayFolder: Time comparison
		lineageTag: 1da41663-4ba9-4467-a3a8-1c7ce3087448

	/// Emissions Change Including New Sites (tCO2e) as a share of the prior year's emissions. Blank when nothing is comparable.
	measure 'Emissions Change Including New Sites (%)' = DIVIDE ( [Emissions Change Including New Sites (tCO2e)], [Emissions Prior Year (tCO2e)] )
		formatString: 0.0%
		displayFolder: Time comparison
		lineageTag: 040fc8ac-85e4-4fdc-8a56-b24dafdc4b4b

	/// Scope 2, market-based (GHG Protocol Scope 2 Guidance): kWh covered by guarantees of origin carry the certificate's factor, the rest the country's residual mix; heat uses the network's declared value. The same kWh as location-based. Factors are illustrative.
	measure 'Scope 2 Market-based Emissions (tCO2e)' = SUM ( fact_scope2_market[tco2e] )
		formatString: #,0.0
		displayFolder: Market-based scope 2
		lineageTag: 152fbbb1-dc5e-41f4-8c83-b50735152b05

	/// Total Emissions with market-based scope 2 in place of location-based scope 2. Scopes 1 and 3 are the same in both totals.
	measure 'Total Emissions Market-based (tCO2e)' = [Total Emissions (tCO2e)] - [Scope 2 Emissions (tCO2e)] + [Scope 2 Market-based Emissions (tCO2e)]
		formatString: #,0.0
		displayFolder: Market-based scope 2
		lineageTag: 33a4b6b5-0b6b-46ae-9d95-ebd1d71ac9bb

	/// Purchased electricity covered by guarantees of origin under a supplier contract (rows with a contract). KEEPFILTERS means another filter on contract_id gives blank.
	measure 'Electricity with Guarantees of Origin (kWh)' = CALCULATE ( SUM ( fact_scope2_market[activity_amount] ), KEEPFILTERS ( NOT ISBLANK ( fact_scope2_market[contract_id] ) ) )
		formatString: #,0
		displayFolder: Market-based scope 2
		lineageTag: 2d5093ab-6747-4a5b-975d-ed9fe7cee936

	/// Share of purchased electricity covered by guarantees of origin. Blank where no contract covers any kWh.
	measure 'Electricity with Guarantees of Origin (%)' = DIVIDE ( [Electricity with Guarantees of Origin (kWh)], [Electricity Purchased (kWh)] )
		formatString: 0.0%
		displayFolder: Market-based scope 2
		lineageTag: 092b17f3-dc43-43a4-ab41-d2282398c926

	/// Scope 3 category 1, spend-based: each month's purchase ledger spend times an illustrative factor per euro for its spend category.
	measure 'Purchased Goods and Services Emissions (tCO2e)' = SUM ( fact_purchases[tco2e] )
		formatString: #,0.0
		displayFolder: Value chain
		lineageTag: 2882bf9a-27c2-4267-ad48-2f227f322d35

	/// Scope 3 category 3, parts (a) upstream of purchased fuels and (c) transmission and distribution losses, worked out from the fuel and kWh the sites report.
	measure 'Fuel and Energy Related Emissions (tCO2e)' = SUM ( fact_energy_upstream[tco2e] )
		formatString: #,0.0
		displayFolder: Value chain
		lineageTag: 43ac37c0-54ce-45e4-93bc-c19d32dae465

	/// Scope 3 category 4: inbound freight and the outbound freight Fjordvik pays for (source S12), distance-based. KEEPFILTERS means a filter on another source gives blank.
	measure 'Upstream Transport Emissions (tCO2e)' = CALCULATE ( SUM ( fact_freight[tco2e] ), KEEPFILTERS ( dim_source[source_id] = "S12" ) )
		formatString: #,0.0
		displayFolder: Value chain
		lineageTag: 4acb8c4e-95ec-4c47-9c35-313e3a02be95

	/// Scope 3 category 9: outbound freight that customers pay for (source S13), distance-based. KEEPFILTERS means a filter on another source gives blank.
	measure 'Downstream Transport Emissions (tCO2e)' = CALCULATE ( SUM ( fact_freight[tco2e] ), KEEPFILTERS ( dim_source[source_id] = "S13" ) )
		formatString: #,0.0
		displayFolder: Value chain
		lineageTag: b7ef48e0-6c6f-4ef8-8ee9-2deef0a0d0ba

	/// Spend in the purchase ledger, in euros. A flow: it adds up over months.
	measure 'Purchased Spend (EUR)' = SUM ( fact_purchases[activity_amount] )
		formatString: #,0
		displayFolder: Value chain
		lineageTag: d0b217f1-3dee-434c-8ded-85d8af6213d9

	/// Freight moved, in tonne-kilometres: tonnes times distance for each lane.
	measure 'Freight Transport (tonne-km)' = SUM ( fact_freight[activity_amount] )
		formatString: #,0
		displayFolder: Value chain
		lineageTag: 9c5d7617-38bb-4cbf-999e-025a8d18f5be

	/// Category 1 emissions per thousand euros spent. Dividing spend by 1,000 turns euros into thousands of euros; the result equals kilograms of CO2 equivalent per euro.
	measure 'Purchased Goods Emissions per Thousand EUR (tCO2e)' = DIVIDE ( [Purchased Goods and Services Emissions (tCO2e)], DIVIDE ( [Purchased Spend (EUR)], 1000 ) )
		formatString: #,0.000
		displayFolder: Value chain
		lineageTag: c0173780-8e59-4e55-862f-e4d4e25b72b3

	/// Stored minus recalculated market-based scope 2, rounded to 0.001 t (1 kg). Anything that survives the rounding means a row's tco2e doesn't match its activity and factor.
	measure 'Market-based Reconciliation Difference (tCO2e)' = ROUND ( [Scope 2 Market-based Emissions (tCO2e)] - SUMX ( fact_scope2_market, fact_scope2_market[activity_amount] * fact_scope2_market[emission_factor] / 1000 ), 3 )
		formatString: #,0.000
		displayFolder: Data quality
		lineageTag: b3ef54f9-9aef-4752-8c47-db55febe7560

	/// Units sold, from the cleaned sales. A flow: it adds up over months.
	measure 'Units Sold' = SUM ( fact_sales[units] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: e74a239a-807a-4cb3-8715-29b1fe903728

	/// Net sales in euros from the cleaned ERP extract. Swedish kronor are converted at the ECB monthly average rate in the SQL.
	measure 'Net Sales (EUR)' = SUM ( fact_sales[net_sales_eur] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 8e297627-a83a-4f08-baf1-c1a7c77daac9

	/// Standard cost of the units sold, in euros.
	measure 'Cost of Sales (EUR)' = SUM ( fact_sales[cost_of_sales_eur] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 9455c9f8-ea74-4f07-8eeb-f9f5f0c9a2d5

	/// Net sales minus cost of sales.
	measure 'Margin (EUR)' = SUM ( fact_sales[margin_eur] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: e738ba0d-9557-4fbe-9e03-0c7647f173d2

	/// Margin as a share of net sales.
	measure 'Margin (%)' = DIVIDE ( [Margin (EUR)], [Net Sales (EUR)] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 2d6bb9ce-3edc-4b7a-8a36-c5b9ee6fa62e

	/// Net sales per unit. Mixes products of very different prices, so read it within one product group.
	measure 'Average Price (EUR)' = DIVIDE ( [Net Sales (EUR)], [Units Sold] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 4a090fbf-6ebd-422c-86eb-beb982bbc7a0

	/// Units sold in the same months a year earlier (the month key shifted back one year). Blank where there is no prior year.
	measure 'Units Sold Prior Year' =
			VAR PriorKeys =
				SELECTCOLUMNS ( VALUES ( dim_date[date_key] ), "date_key", dim_date[date_key] - 10000 )
			RETURN
				CALCULATE ( [Units Sold], REMOVEFILTERS ( dim_date ), TREATAS ( PriorKeys, dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 78b7b05f-ca9e-4de4-b454-ea7bae24b429

	/// Net sales in the same months a year earlier.
	measure 'Net Sales Prior Year (EUR)' =
			VAR PriorKeys =
				SELECTCOLUMNS ( VALUES ( dim_date[date_key] ), "date_key", dim_date[date_key] - 10000 )
			RETURN
				CALCULATE ( [Net Sales (EUR)], REMOVEFILTERS ( dim_date ), TREATAS ( PriorKeys, dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 60e1c35f-d0a8-4d23-91f9-5ce21e4674f2

	/// Cost of sales in the same months a year earlier.
	measure 'Cost of Sales Prior Year (EUR)' =
			VAR PriorKeys =
				SELECTCOLUMNS ( VALUES ( dim_date[date_key] ), "date_key", dim_date[date_key] - 10000 )
			RETURN
				CALCULATE ( [Cost of Sales (EUR)], REMOVEFILTERS ( dim_date ), TREATAS ( PriorKeys, dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 9ab5f49b-7b9c-4c06-b59c-2f44576550b8

	/// Margin in the same months a year earlier.
	measure 'Margin Prior Year (EUR)' =
			VAR PriorKeys =
				SELECTCOLUMNS ( VALUES ( dim_date[date_key] ), "date_key", dim_date[date_key] - 10000 )
			RETURN
				CALCULATE ( [Margin (EUR)], REMOVEFILTERS ( dim_date ), TREATAS ( PriorKeys, dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 3773669f-5a99-4e07-b6b4-6585da5907e0

	/// This period's margin minus the same months a year earlier. Equals the sum of the price, volume, cost and not-comparable effects. Blank with no prior year.
	measure 'Margin Change vs Prior Year (EUR)' = IF ( NOT ISBLANK ( [Margin Prior Year (EUR)] ), [Margin (EUR)] - [Margin Prior Year (EUR)] )
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: 4eb82a90-ceff-4ac1-80e6-dd36b7485117

	/// ACCA F5 sales variances with the prior year as standard: actual = this period, standard = the same months a year earlier, compared product by product over products sold in both. Price effect = (actual price - prior-year price) x actual units. The joint price-times-volume piece sits here, as most textbooks place it (Sorochuk, Vinroot and Leemis, 2023).
	measure 'Price Effect (EUR)' =
			VAR Products =
				ADDCOLUMNS (
					VALUES ( dim_product[product_id] ),
					"@AU", [Units Sold], "@PU", [Units Sold Prior Year],
					"@S", [Net Sales (EUR)], "@PS", [Net Sales Prior Year (EUR)],
					"@C", [Cost of Sales (EUR)], "@PC", [Cost of Sales Prior Year (EUR)]
				)
			VAR Comparable = FILTER ( Products, NOT ISBLANK ( [@AU] ) && NOT ISBLANK ( [@PU] ) )
			RETURN
				SUMX ( Comparable, [@S] - DIVIDE ( [@PS], [@PU] ) * [@AU] )
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: 6057c02f-71ba-4847-bfc5-03f8fe1dcfb3

	/// ACCA F5 sales variances with the prior year as standard: actual = this period, standard = the same months a year earlier, compared product by product over products sold in both. Mix effect = (actual units - actual total units in the prior-year mix) x prior-year margin per unit, measured on units (ACCA examiner's report, June 2020). Across very different products (pumps and spare parts) it is large and offset by quantity: read it within one family.
	measure 'Mix Effect (EUR)' =
			VAR Products =
				ADDCOLUMNS (
					VALUES ( dim_product[product_id] ),
					"@AU", [Units Sold], "@PU", [Units Sold Prior Year],
					"@S", [Net Sales (EUR)], "@PS", [Net Sales Prior Year (EUR)],
					"@C", [Cost of Sales (EUR)], "@PC", [Cost of Sales Prior Year (EUR)]
				)
			VAR Comparable = FILTER ( Products, NOT ISBLANK ( [@AU] ) && NOT ISBLANK ( [@PU] ) )
			VAR TotalAU = SUMX ( Comparable, [@AU] )
			VAR TotalPU = SUMX ( Comparable, [@PU] )
			RETURN
				SUMX ( Comparable, ( [@AU] - TotalAU * DIVIDE ( [@PU], TotalPU ) ) * DIVIDE ( [@PS] - [@PC], [@PU] ) )
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: 4bd0da78-6d29-4f4a-a420-f922e0e98ad3

	/// ACCA F5 sales variances with the prior year as standard: actual = this period, standard = the same months a year earlier, compared product by product over products sold in both. Quantity effect = (actual total units in the prior-year mix - prior-year units) x prior-year margin per unit.
	measure 'Quantity Effect (EUR)' =
			VAR Products =
				ADDCOLUMNS (
					VALUES ( dim_product[product_id] ),
					"@AU", [Units Sold], "@PU", [Units Sold Prior Year],
					"@S", [Net Sales (EUR)], "@PS", [Net Sales Prior Year (EUR)],
					"@C", [Cost of Sales (EUR)], "@PC", [Cost of Sales Prior Year (EUR)]
				)
			VAR Comparable = FILTER ( Products, NOT ISBLANK ( [@AU] ) && NOT ISBLANK ( [@PU] ) )
			VAR TotalAU = SUMX ( Comparable, [@AU] )
			VAR TotalPU = SUMX ( Comparable, [@PU] )
			RETURN
				SUMX ( Comparable, ( TotalAU * DIVIDE ( [@PU], TotalPU ) - [@PU] ) * DIVIDE ( [@PS] - [@PC], [@PU] ) )
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: eb41ad01-a7db-4163-b0e9-7b47ce8d3ea0

	/// ACCA F5 sales variances with the prior year as standard: actual = this period, standard = the same months a year earlier, compared product by product over products sold in both. Volume effect = mix effect + quantity effect = (actual units - prior-year units) x prior-year margin per unit.
	measure 'Volume Effect (EUR)' = [Mix Effect (EUR)] + [Quantity Effect (EUR)]
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: 6b8849cf-c237-4ae6-b68b-14879d5f93ff

	/// Change in unit cost against the prior year: (prior-year cost per unit - actual cost per unit) x actual units, over products sold in both periods. Completes the margin bridge.
	measure 'Cost Effect (EUR)' =
			VAR Products =
				ADDCOLUMNS (
					VALUES ( dim_product[product_id] ),
					"@AU", [Units Sold], "@PU", [Units Sold Prior Year],
					"@S", [Net Sales (EUR)], "@PS", [Net Sales Prior Year (EUR)],
					"@C", [Cost of Sales (EUR)], "@PC", [Cost of Sales Prior Year (EUR)]
				)
			VAR Comparable = FILTER ( Products, NOT ISBLANK ( [@AU] ) && NOT ISBLANK ( [@PU] ) )
			RETURN
				SUMX ( Comparable, DIVIDE ( [@PC], [@PU] ) * [@AU] - [@C] )
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: 41d1db14-d0ae-4374-b972-d7eea54deb90

	/// Margin change from products sold in only one of the two periods, kept apart so the ACCA effects compare like with like. Blank with no prior year.
	measure 'Not Comparable Change (EUR)' =
			VAR Products =
				ADDCOLUMNS (
					VALUES ( dim_product[product_id] ),
					"@AU", [Units Sold], "@PU", [Units Sold Prior Year],
					"@S", [Net Sales (EUR)], "@PS", [Net Sales Prior Year (EUR)],
					"@C", [Cost of Sales (EUR)], "@PC", [Cost of Sales Prior Year (EUR)]
				)
			VAR Comparable = FILTER ( Products, NOT ISBLANK ( [@AU] ) && NOT ISBLANK ( [@PU] ) )
			RETURN
				IF (
					NOT ISBLANK ( [Margin Prior Year (EUR)] ),
					SUMX ( FILTER ( Products, ISBLANK ( [@AU] ) || ISBLANK ( [@PU] ) ), ( [@S] - [@C] ) - ( [@PS] - [@PC] ) )
				)
		formatString: #,0
		displayFolder: Price, volume and mix
		lineageTag: 84cea303-d9d3-4143-81bd-1be0a96c5fbb

	/// Share of all net sales in the same months and sites, across every product and region: portfolio balance.
	measure 'Share of Net Sales (%)' = DIVIDE ( [Net Sales (EUR)], CALCULATE ( [Net Sales (EUR)], REMOVEFILTERS ( dim_product ), REMOVEFILTERS ( dim_product_group ), REMOVEFILTERS ( dim_region ) ) )
		formatString: 0.0%
		displayFolder: Portfolio balance
		lineageTag: 306aac84-7111-430d-afb1-c9309c065b69

	/// Share of all margin in the same months and sites, across every product and region.
	measure 'Share of Margin (%)' = DIVIDE ( [Margin (EUR)], CALCULATE ( [Margin (EUR)], REMOVEFILTERS ( dim_product ), REMOVEFILTERS ( dim_product_group ), REMOVEFILTERS ( dim_region ) ) )
		formatString: 0.0%
		displayFolder: Portfolio balance
		lineageTag: 87ea2f0f-2cc2-438c-b319-d2882f4bfd4b

	/// Scope 3 category 11: the lifetime electricity of the pumps sold, at the grid factor of the region of use (GHG Protocol direct use-phase method). Rest of world is not calculated. Factors are illustrative.
	measure 'Use-phase Emissions (tCO2e)' = SUM ( fact_use_phase[tco2e] )
		formatString: #,0.0
		displayFolder: Product sustainability
		lineageTag: c717ee23-89e1-4e30-a085-b65a265cbd24

	/// Category 11 per unit sold, over the units it covers (energy-using products outside Rest of world).
	measure 'Use-phase Emissions per Unit (tCO2e)' = DIVIDE ( [Use-phase Emissions (tCO2e)], SUM ( fact_use_phase[units] ) )
		formatString: #,0.0
		displayFolder: Product sustainability
		lineageTag: 03483a05-497a-473f-97d7-d914558c1879

	/// Category 11 per thousand euros of the sales it covers. Dividing sales by 1,000 turns euros into thousands of euros.
	measure 'Use-phase Emissions per Thousand EUR (tCO2e)' = DIVIDE ( [Use-phase Emissions (tCO2e)], DIVIDE ( SUM ( fact_use_phase[net_sales_eur] ), 1000 ) )
		formatString: #,0.00
		displayFolder: Product sustainability
		lineageTag: 724f013a-cdb5-4967-9a81-378f43db17c1

	/// Scorecard score: ratings (1 to 10) times each criterion's weight, divided by the sum of the weights (Cooper and Edgett's scoring model). Weights are Fjordvik's own choice, held in dim_score_criterion.
	measure 'Weighted Score' = DIVIDE ( SUMX ( fact_product_rating, fact_product_rating[rating] * RELATED ( dim_score_criterion[weight] ) ), SUMX ( fact_product_rating, RELATED ( dim_score_criterion[weight] ) ) )
		formatString: 0.0
		displayFolder: Scorecard
		lineageTag: afbd5b67-bfe8-4fd6-bcaf-b4282cd90729

	/// Value of extract lines held back because their item number is not in the global classification. KEEPFILTERS means a filter on another status gives blank.
	measure 'Quarantined Sales (EUR)' = CALCULATE ( SUM ( fact_data_issue[amount_eur] ), KEEPFILTERS ( fact_data_issue[status] = "Quarantined" ) )
		formatString: #,0.00
		displayFolder: Data quality
		lineageTag: a54eee44-d881-4b81-b7b8-e9277ce7147f

	/// Finance revenue minus clean sales minus quarantined sales, rounded to the cent. Should be zero; read it without a product or region filter, since revenue has neither.
	measure 'Sales Reconciliation Difference (EUR)' = ROUND ( [Revenue (EUR)] - [Net Sales (EUR)] - [Quarantined Sales (EUR)], 2 )
		formatString: #,0.00
		displayFolder: Data quality
		lineageTag: 5eaee3c5-8de7-4925-875e-30d53b880627

	/// Number of issues the SQL logged in the ERP extract.
	measure 'Data Issues' = COUNTROWS ( fact_data_issue )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 5c37ec5a-cff1-4ad4-9048-16496c7edd47

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 931fea15-6e14-42f5-805b-385f2e6fcd80
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Placeholder", "" )

	annotation PBI_ResultType = Table

