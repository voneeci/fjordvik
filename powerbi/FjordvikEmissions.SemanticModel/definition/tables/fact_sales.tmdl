/// One row per month, shipping site, product and region, cleaned by SQL from the simulated Oracle extract. Reconciles to finance revenue.
table fact_sales
	lineageTag: 73f22979-b4f6-4797-92a4-4928a6344dd3

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 98a60a55-be7f-4b76-bb4d-6a15a6548ce3
		summarizeBy: none
		sourceColumn: date_key

	column site_id
		dataType: string
		isHidden
		lineageTag: 07bff349-e58d-4e2c-bc45-a8d6b124de9a
		summarizeBy: none
		sourceColumn: site_id

	column product_id
		dataType: string
		isHidden
		lineageTag: e21fe633-ea0d-41c4-9ccc-7fb30f71915d
		summarizeBy: none
		sourceColumn: product_id

	column region_id
		dataType: string
		isHidden
		lineageTag: 0825cc9b-fe20-4277-aa22-fb5a61abd52b
		summarizeBy: none
		sourceColumn: region_id

	column units
		dataType: int64
		formatString: #,0
		lineageTag: 0e2a22a1-466a-4dc5-bf6a-bd1f2d1784ba
		summarizeBy: none
		sourceColumn: units

	column net_sales_eur
		dataType: double
		formatString: #,0.00
		lineageTag: aa34a850-e1e2-4fb9-91a4-b4372865a426
		summarizeBy: none
		sourceColumn: net_sales_eur

	column cost_of_sales_eur
		dataType: double
		formatString: #,0.00
		lineageTag: 6c7f800d-a328-4173-98df-a43742ba39cd
		summarizeBy: none
		sourceColumn: cost_of_sales_eur

	column margin_eur
		dataType: double
		formatString: #,0.00
		lineageTag: ac748c5f-8c32-43b6-aae5-a1f4aa27dd2e
		summarizeBy: none
		sourceColumn: margin_eur

	partition fact_sales = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\fact_sales.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"site_id", type text}, {"product_id", type text}, {"region_id", type text}, {"units", Int64.Type}, {"net_sales_eur", type number}, {"cost_of_sales_eur", type number}, {"margin_eur", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
