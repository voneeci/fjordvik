/// The 13 emission sources, with their Greenhouse Gas Protocol scope, scope 3 category and calculation method.
table dim_source
	lineageTag: de6426e1-d0b4-4cfa-8587-eaaeecfaa15d

	column source_id
		dataType: string
		lineageTag: 2752fa19-130e-4936-985a-d9e2e19c7631
		summarizeBy: none
		sourceColumn: source_id

	column source_name
		dataType: string
		lineageTag: 8d3fa45f-afd2-49d7-b5b6-1a532ca5f231
		summarizeBy: none
		sourceColumn: source_name

	column scope
		dataType: int64
		formatString: 0
		lineageTag: b22c88b6-0259-4946-9d8c-14327ba727ce
		summarizeBy: none
		sourceColumn: scope

	column category
		dataType: string
		lineageTag: dd91871a-e3c9-4a23-bafe-43a2367c8cfb
		summarizeBy: none
		sourceColumn: category

	/// Greenhouse Gas Protocol scope 3 category, 1 to 15. Blank for scopes 1 and 2.
	column scope3_category
		dataType: int64
		formatString: 0
		lineageTag: 9c6bad23-a7a1-44da-b51d-a6875b4bfee7
		summarizeBy: none
		sourceColumn: scope3_category

	column method
		dataType: string
		lineageTag: 935ba846-14d9-45cb-804b-c94da380db22
		summarizeBy: none
		sourceColumn: method

	partition dim_source = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_source.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// An empty field is a blank, not empty text, so it types cleanly and joins to nothing
					Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"scope3_category"}),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Blanks, {{"source_id", type text}, {"source_name", type text}, {"scope", Int64.Type}, {"category", type text}, {"scope3_category", Int64.Type}, {"method", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table

