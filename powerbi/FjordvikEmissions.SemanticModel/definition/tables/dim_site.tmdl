/// The six sites. Row-level security filters this table by country.
table dim_site
	lineageTag: 14b53f24-4536-4f48-85ce-fc698839c633

	column site_id
		dataType: string
		lineageTag: 3984683c-65dc-4e1b-badd-9095f4a4b28c
		summarizeBy: none
		sourceColumn: site_id

	column site_name
		dataType: string
		lineageTag: 6e147281-f22b-4969-8ba5-49f133a42ba0
		summarizeBy: none
		sourceColumn: site_name

	column country
		dataType: string
		lineageTag: 78d5232e-3292-4d7c-9716-337234849304
		summarizeBy: none
		sourceColumn: country

	column site_type
		dataType: string
		lineageTag: 3e64b8d7-48ac-4f4a-af7f-4f8c87822c4a
		summarizeBy: none
		sourceColumn: site_type

	partition dim_site = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_site.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"site_id", type text}, {"site_name", type text}, {"country", type text}, {"site_type", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table

