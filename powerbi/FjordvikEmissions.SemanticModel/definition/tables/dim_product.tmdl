/// One row per product model. Rated kW, yearly kWh and lifetime are Fjordvik's own engineering specification.
table dim_product
	lineageTag: e36a12b4-d24c-49f0-b8fb-701192ae07f1

	/// Global product code.
	column product_id
		dataType: string
		lineageTag: 1c5cb660-f4c2-4983-a6ef-58f9479f9df3
		summarizeBy: none
		sourceColumn: product_id

	column product_name
		dataType: string
		lineageTag: b99c59ae-5568-4a4e-b0ac-4535fb114958
		summarizeBy: none
		sourceColumn: product_name

	column product_group
		dataType: string
		isHidden
		lineageTag: ed3cc106-7eac-4a51-b88f-adca21fd3616
		summarizeBy: none
		sourceColumn: product_group

	column product_family
		dataType: string
		lineageTag: 13f51867-6dc1-424b-a7bc-58ec5aed05d8
		summarizeBy: none
		sourceColumn: product_family

	column made_at_site_id
		dataType: string
		lineageTag: 6c8e5a32-5139-4cbf-9ef3-adc9d7055e09
		summarizeBy: none
		sourceColumn: made_at_site_id

	column rated_kw
		dataType: int64
		formatString: 0
		lineageTag: e9a1bf2c-c215-4162-8881-83c809d8260e
		summarizeBy: none
		sourceColumn: rated_kw

	/// Expected electricity use per year in service.
	column kwh_per_year
		dataType: int64
		formatString: #,0
		lineageTag: 41ef868f-3221-4c53-8251-e0492aa0576d
		summarizeBy: none
		sourceColumn: kwh_per_year

	column lifetime_years
		dataType: int64
		formatString: 0
		lineageTag: f9086f77-821d-42fe-998c-05fffe9e4ca2
		summarizeBy: none
		sourceColumn: lifetime_years

	column list_price_eur
		dataType: double
		formatString: #,0
		lineageTag: 3a565401-7bac-45eb-b9aa-6ae8157bc9b4
		summarizeBy: none
		sourceColumn: list_price_eur

	column standard_cost_eur
		dataType: double
		formatString: #,0
		lineageTag: fc95d80b-a27e-436b-8b2f-004d1093fe99
		summarizeBy: none
		sourceColumn: standard_cost_eur

	partition dim_product = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_product.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"product_id", type text}, {"product_name", type text}, {"product_group", type text}, {"product_family", type text}, {"made_at_site_id", type text}, {"rated_kw", Int64.Type}, {"kwh_per_year", Int64.Type}, {"lifetime_years", Int64.Type}, {"list_price_eur", type number}, {"standard_cost_eur", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
