/// The global classification: each business unit's local item number for each product.
table dim_product_code
	lineageTag: 41623bfa-0c1e-4af5-a191-83f48f542ee9

	column business_unit
		dataType: string
		lineageTag: 6232943f-2a18-404c-a838-79349029ac44
		summarizeBy: none
		sourceColumn: business_unit

	column local_item_number
		dataType: string
		lineageTag: f75c8868-9e72-46d0-97a7-a3599064bb39
		summarizeBy: none
		sourceColumn: local_item_number

	column product_id
		dataType: string
		isHidden
		lineageTag: adc298ba-8d36-47fb-af58-caa5cb5b9365
		summarizeBy: none
		sourceColumn: product_id

	partition dim_product_code = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_product_code.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"business_unit", type text}, {"local_item_number", type text}, {"product_id", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table

