/// Scope 3 category 3, parts (a) and (c): upstream emissions of purchased fuels and transmission and distribution losses, derived from the fuel and kWh in fact_emissions. Factors are illustrative.
table fact_energy_upstream
	lineageTag: b87e3864-3fd2-4967-a77e-cbd494f45221

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4182c36f-2c3f-455e-bb8c-24869e0fcd2a
		summarizeBy: none
		sourceColumn: date_key

	column site_id
		dataType: string
		isHidden
		lineageTag: 5c261147-9456-49e4-af93-2a4b1848cd29
		summarizeBy: none
		sourceColumn: site_id

	column source_id
		dataType: string
		isHidden
		lineageTag: 3f9df76f-ace7-4f59-a4bf-4937b2429b9a
		summarizeBy: none
		sourceColumn: source_id

	/// The fact_emissions source this row is worked out from.
	column based_on_source_id
		dataType: string
		lineageTag: b0f5c8ba-370e-4a21-a95b-9179329e84ad
		summarizeBy: none
		sourceColumn: based_on_source_id

	column activity_amount
		dataType: double
		formatString: #,0.00
		lineageTag: 23da024c-8f9c-4cc2-af2f-9ea9800686f1
		summarizeBy: none
		sourceColumn: activity_amount

	column unit
		dataType: string
		lineageTag: 3baa035c-d4df-4421-bd47-ac0e6e710ed0
		summarizeBy: none
		sourceColumn: unit

	/// Illustrative factor in kilograms of CO2 equivalent per unit. Not for real reporting.
	column emission_factor
		dataType: double
		formatString: #,0.000
		lineageTag: 43c1033e-dd77-47f1-868e-9690b4205855
		summarizeBy: none
		sourceColumn: emission_factor

	/// Tonnes of CO2 equivalent, as stored in the source data.
	column tco2e
		dataType: double
		formatString: #,0.000000
		lineageTag: bc2cd38d-d241-467b-a447-6d294bdf72a6
		summarizeBy: none
		sourceColumn: tco2e

	partition fact_energy_upstream = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\fact_energy_upstream.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"site_id", type text}, {"source_id", type text}, {"based_on_source_id", type text}, {"activity_amount", type number}, {"unit", type text}, {"emission_factor", type number}, {"tco2e", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table

