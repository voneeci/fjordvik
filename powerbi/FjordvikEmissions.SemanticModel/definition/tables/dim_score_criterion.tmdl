/// The six scorecard criteria (Cooper and Edgett) and the weight Fjordvik gives each: its own stated choice.
table dim_score_criterion
	lineageTag: b90a6754-7c5a-471f-b686-766abd4fe4f4

	column criterion_id
		dataType: string
		lineageTag: 35cafeed-70e6-402a-b847-44fedf4d69ea
		summarizeBy: none
		sourceColumn: criterion_id

	column criterion_name
		dataType: string
		lineageTag: 1888e254-d4db-4983-a4bf-d6cbefac932f
		summarizeBy: none
		sourceColumn: criterion_name

	/// Fjordvik's own weight; no source publishes weights.
	column weight
		dataType: int64
		formatString: 0
		lineageTag: 2509a40e-c56f-4f11-8f1a-33505c474fd0
		summarizeBy: none
		sourceColumn: weight

	column source
		dataType: string
		lineageTag: e94407b1-e243-4198-9f63-35b2578b9ad0
		summarizeBy: none
		sourceColumn: source

	partition dim_score_criterion = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_score_criterion.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"criterion_id", type text}, {"criterion_name", type text}, {"weight", Int64.Type}, {"source", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
