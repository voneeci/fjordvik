/// Electricity contracts backed by guarantees of origin, from the supplier contracts and cancellation statements. Supplier names are synthetic.
table dim_contract
	lineageTag: 6bf50a27-76ed-4e5e-a753-fbb7a25d96f5

	column contract_id
		dataType: string
		lineageTag: 8894c09e-7bf6-4665-8a13-47852cc29dbc
		summarizeBy: none
		sourceColumn: contract_id

	column site_id
		dataType: string
		lineageTag: 3a161661-b2fc-4142-a6c3-25da1c23c654
		summarizeBy: none
		sourceColumn: site_id

	column source_id
		dataType: string
		lineageTag: b8ec6ab2-b887-4d27-b3c2-dc43889ca565
		summarizeBy: none
		sourceColumn: source_id

	column supplier_name
		dataType: string
		lineageTag: fd0b202c-495e-4cb9-8bb9-22232045f307
		summarizeBy: none
		sourceColumn: supplier_name

	column instrument
		dataType: string
		lineageTag: 29e27d08-7523-4c8f-bffd-4bbf5a1cfb60
		summarizeBy: none
		sourceColumn: instrument

	column start_date_key
		dataType: int64
		formatString: 0
		lineageTag: f4c79508-a1fa-4335-9deb-97fced7f24e1
		summarizeBy: none
		sourceColumn: start_date_key

	column end_date_key
		dataType: int64
		formatString: 0
		lineageTag: fc3c01ea-039d-4def-97a8-e237e8492fc0
		summarizeBy: none
		sourceColumn: end_date_key

	/// Share of the site's monthly kWh covered by the contract's guarantees of origin.
	column covered_share
		dataType: double
		formatString: 0%
		lineageTag: edd6a4e9-58e7-43a7-9041-50c813aa241a
		summarizeBy: none
		sourceColumn: covered_share

	partition dim_contract = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_contract.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"contract_id", type text}, {"site_id", type text}, {"source_id", type text}, {"supplier_name", type text}, {"instrument", type text}, {"start_date_key", Int64.Type}, {"end_date_key", Int64.Type}, {"covered_share", type number}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
