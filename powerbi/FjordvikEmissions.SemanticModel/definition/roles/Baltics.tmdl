/// Sales region manager for Baltics: sees only Baltics sales, margin, scorecard and category 11. The site emission and finance tables are denied, so site figures show blank.
role Baltics
	modelPermission: read

	tablePermission dim_region = dim_region[region_id] = "BAL"

	tablePermission fact_emissions = FALSE()

	tablePermission fact_energy_upstream = FALSE()

	tablePermission fact_purchases = FALSE()

	tablePermission fact_freight = FALSE()

	tablePermission fact_scope2_market = FALSE()

	tablePermission fact_site_metrics = FALSE()

	tablePermission fact_data_issue = FALSE()

	annotation PBI_Id = 4b3e2da63e9d426298a21b92428ca1cd

