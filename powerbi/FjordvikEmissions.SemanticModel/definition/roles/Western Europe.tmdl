/// Sales region manager for Western Europe: sees only Western Europe sales, margin, scorecard and category 11. The site emission and finance tables are denied, so site figures show blank.
role 'Western Europe'
	modelPermission: read

	tablePermission dim_region = dim_region[region_id] = "WEU"

	tablePermission fact_emissions = FALSE()
	tablePermission fact_energy_upstream = FALSE()
	tablePermission fact_purchases = FALSE()
	tablePermission fact_freight = FALSE()
	tablePermission fact_scope2_market = FALSE()
	tablePermission fact_site_metrics = FALSE()
	tablePermission fact_data_issue = FALSE()

	annotation PBI_Id = c5d378f2cbe5423aa8bf6ea03777468e
