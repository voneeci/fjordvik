                      "fontSize": "3pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Year",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ": each page opens on the latest full year (2025), and the scorecard on its latest quarter. Charts by month or quarter always show all three years.",
