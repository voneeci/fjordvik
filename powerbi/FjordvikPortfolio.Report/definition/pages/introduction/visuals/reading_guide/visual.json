              {
                "textRuns": [
                  {
                    "value": "How to read the figures",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each page opens on the latest full year (2025); the scorecard on its latest quarter. Charts by month or quarter always show all three years.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Under each headline number: the same months a year earlier and the change, then the budget and the variance on it. A rate (margin %) moves in percentage points (pts).",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The margin bridge follows the ACCA sales variances with the prior year as standard: sales prices, mix, delivery volumes (quantity) and variable costs (cost per unit). Products sold in only one of the two years are shown apart as not comparable.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "K means thousands, M millions.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
