                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Page titles",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ": each is a sentence worked out from the data, so it never goes stale.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Under each headline number",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ": the same months a year earlier and the change, then the budget and the variance on it.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rates",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ": margin % moves in percentage points (pts).",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Margin bridge",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": ": the ACCA (Association of Chartered Certified Accountants) sales variances, with the prior year as standard: sales prices, mix, delivery volumes (quantity) and variable costs (cost per unit).",
