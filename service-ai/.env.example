# Settings for the Fjordvik service AI. Names only: never put a value in this file.
# Copy to .env (git-ignored) or set them in your environment. Tests need none of them.

# Claude API key for the service assistant (phase 6) and agent (phase 7) live runs.
# ANTHROPIC_API_KEY=

# Folder holding the shared tables. Defaults to the repository's data\tables folder.
# FJORDVIK_DATA_DIR=
