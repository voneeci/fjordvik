/// The eight emission sources, with their Greenhouse Gas Protocol scope.
table dim_source

	column source_id
		dataType: string
		summarizeBy: none
		sourceColumn: source_id

	column source_name
		dataType: string
		summarizeBy: none
		sourceColumn: source_name

	column scope
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: scope

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	partition dim_source = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_source.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					// "en-US" so "0.200" is read with a full stop as the decimal mark on any Windows locale
					Typed = Table.TransformColumnTypes(Promoted, {{"source_id", type text}, {"source_name", type text}, {"scope", Int64.Type}, {"category", type text}}, "en-US")
				in
					Typed

	annotation PBI_ResultType = Table
