/// Home table for every measure. Holds no data; its one column is hidden.
table _Measures

	/// Tonnes of CO2 equivalent across all scopes, from the stored tco2e column.
	measure 'Total Emissions (tCO2e)' = SUM ( fact_emissions[tco2e] )
		formatString: #,0.0
		displayFolder: Emissions

	/// Scope 1. Direct emissions: fuels burned on site and refrigerant leaks. KEEPFILTERS means a slicer on another scope gives blank, not this scope's total.
	measure 'Scope 1 Emissions (tCO2e)' = CALCULATE ( [Total Emissions (tCO2e)], KEEPFILTERS ( dim_source[scope] = 1 ) )
		formatString: #,0.0
		displayFolder: Emissions

	/// Scope 2. Purchased electricity and heat, location-based. KEEPFILTERS means a slicer on another scope gives blank, not this scope's total.
	measure 'Scope 2 Emissions (tCO2e)' = CALCULATE ( [Total Emissions (tCO2e)], KEEPFILTERS ( dim_source[scope] = 2 ) )
		formatString: #,0.0
		displayFolder: Emissions

	/// Scope 3. Business flights and waste to landfill. KEEPFILTERS means a slicer on another scope gives blank, not this scope's total.
	measure 'Scope 3 Emissions (tCO2e)' = CALCULATE ( [Total Emissions (tCO2e)], KEEPFILTERS ( dim_source[scope] = 3 ) )
		formatString: #,0.0
		displayFolder: Emissions

	/// Revenue in euros. A flow: it adds up over months.
	measure 'Revenue (EUR)' = SUM ( fact_site_metrics[revenue_eur] )
		formatString: #,0
		displayFolder: Intensity

	/// Full-time equivalent employees. A level, not a flow: summed across sites within each month, then averaged over the months.
	measure 'Average FTE' = AVERAGEX ( VALUES ( dim_date[date_key] ), CALCULATE ( SUM ( fact_site_metrics[fte] ) ) )
		formatString: #,0.0
		displayFolder: Intensity

	/// Total emissions divided by average FTE for the selected period.
	measure 'Emissions per FTE (tCO2e)' = DIVIDE ( [Total Emissions (tCO2e)], [Average FTE] )
		formatString: #,0.00
		displayFolder: Intensity

	/// Total emissions per million euros of revenue (1,000,000 converts euros to millions). Blank where there is no revenue, such as the head office.
	measure 'Emissions per Million EUR (tCO2e)' = DIVIDE ( [Total Emissions (tCO2e)], DIVIDE ( [Revenue (EUR)], 1000000 ) )
		formatString: #,0.0
		displayFolder: Intensity

	/// Emissions for the same months one year earlier. dim_date has one row per month, so it can't be marked as a date table and SAMEPERIODLASTYEAR doesn't apply; this shifts each month key back a year instead (20250301 to 20240301).
	measure 'Emissions Prior Year (tCO2e)' =
			VAR PriorKeys =
				SELECTCOLUMNS ( VALUES ( dim_date[date_key] ), "date_key", dim_date[date_key] - 10000 )
			RETURN
				CALCULATE ( [Total Emissions (tCO2e)], REMOVEFILTERS ( dim_date ), TREATAS ( PriorKeys, dim_date[date_key] ) )
		formatString: #,0.0
		displayFolder: Time comparison

	/// Like-for-like change against the same months a year earlier: only site-months with emissions in both years count, so a site that opened partway through (Tartu, July 2024) or months with no prior year (2023) don't inflate the change. Shown as a percentage; blank when nothing is comparable.
	measure 'Emissions Change vs Prior Year (%)' =
			VAR Comparable =
				FILTER (
					CROSSJOIN ( VALUES ( dim_site[site_id] ), VALUES ( dim_date[date_key] ) ),
					NOT ISBLANK ( CALCULATE ( [Total Emissions (tCO2e)] ) )
						&& NOT ISBLANK ( CALCULATE ( [Emissions Prior Year (tCO2e)] ) )
				)
			VAR CurrentYear = SUMX ( Comparable, CALCULATE ( [Total Emissions (tCO2e)] ) )
			VAR PriorYear = SUMX ( Comparable, CALCULATE ( [Emissions Prior Year (tCO2e)] ) )
			RETURN
				DIVIDE ( CurrentYear - PriorYear, PriorYear )
		formatString: 0.0%
		displayFolder: Time comparison

	/// Emissions worked out again row by row: activity times factor, divided by 1,000 to turn kilograms into tonnes.
	measure 'Recalculated Emissions (tCO2e)' = SUMX ( fact_emissions, fact_emissions[activity_amount] * fact_emissions[emission_factor] / 1000 )
		formatString: #,0.0
		displayFolder: Data quality

	/// Stored minus recalculated emissions, rounded to 0.001 t (1 kg): the stored values carry 6 decimals, so adding 1,422 of them leaves a few grams of rounding. Anything that survives the rounding means a row's tco2e doesn't match its activity and factor.
	measure 'Reconciliation Difference (tCO2e)' = ROUND ( [Total Emissions (tCO2e)] - [Recalculated Emissions (tCO2e)], 3 )
		formatString: #,0.000
		displayFolder: Data quality

	/// Number of emission rows in the current filter.
	measure 'Emission Rows' = COUNTROWS ( fact_emissions )
		formatString: #,0
		displayFolder: Data quality

	/// Number of sites with at least one emission row in the current filter.
	measure 'Sites Reporting' = DISTINCTCOUNT ( fact_emissions[site_id] )
		formatString: #,0
		displayFolder: Data quality

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Placeholder", "" )

	annotation PBI_ResultType = Table
